{
  // ステップワイズの API Worker。画面は GitHub Pages のまま、ここは JSON API だけを返す。
  // 最上位が本番、env.local が開発用。Time Hub / Money Hub と同じ形にしてある。
  // 秘密（TEACHER_TOKEN 等）は `wrangler secret put` で登録し、このファイルには書かない。
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "stepwise-api",
  "main": "worker/index.mjs",
  // gas/*.gs を Worker から呼べる形にまとめ直す（cf/worker/generated/gas.mjs）。
  // dev と deploy の前に必ず走るので、GAS を直したら Worker 側にも自動で反映される。
  // 走るのはリポジトリの直下から（npm run cf:dev / cf:deploy を使うこと）
  "build": { "command": "node scripts/build-gas-bundle.mjs" },
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ALLOW_ORIGIN": "https://www.stepwise-education.jp",
    "NL_ENABLED": "1",
    // 付随処理（メール・カレンダー）を頼む先。秘密ではない（画面にも載る公開の口で、中身は鍵で守る）
    "GAS_URL": "https://script.google.com/macros/s/AKfycbz53sl4GgKNY1UY1gaBndjDplQk5MrA9EfShYfy05Jl4JNEFEl7-B1uKSmd0v5Mhn4Irw/exec",
    // 書き込みの正本。"worker" にすると Worker が台帳を書く。空なら今までどおり Apps Script
    "WRITE_MODE": "worker"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stepwise",
      // 本番 D1。`wrangler d1 create stepwise` の出力で置き換える（docs/D1_MIGRATION.md 段階 A）。
      "database_id": "889ff9cf-4bb0-4ef9-ba0e-b4ce2105f039",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "local": {
      "vars": { "ALLOW_ORIGIN": "*", "AUTH_MODE": "mock", "NL_ENABLED": "0" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stepwise-local",
          "database_id": "00000000-0000-4000-8000-000000000001",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
